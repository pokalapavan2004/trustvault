# Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://trustvault_user:trustvault_password@localhost:5432/trustvault
DATABASE_SSL=false

# Rate Limiting
LOGIN_RATE_LIMIT_MAX=5

# Seed Accounts Credentials
SEED_ADMIN_EMAIL=admin@trustvault.local
SEED_ADMIN_PASSWORD=AdminSecurePass123!

SEED_OWNER1_EMAIL=owner1@trustvault.local
SEED_OWNER1_PASSWORD=Owner1SecurePass123!

SEED_OWNER2_EMAIL=owner2@trustvault.local
SEED_OWNER2_PASSWORD=Owner2SecurePass123!

SEED_VIEWER1_EMAIL=viewer1@trustvault.local
SEED_VIEWER1_PASSWORD=Viewer1SecurePass123!

SEED_VIEWER2_EMAIL=viewer2@trustvault.local
SEED_VIEWER2_PASSWORD=Viewer2SecurePass123!
