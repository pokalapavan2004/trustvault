# TrustVault Backend Environment Configuration Example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustvault
DATABASE_SSL=false

# Initial Admin Seeding (required for db/seed.js)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@trustvault.local
SEED_ADMIN_PASSWORD=ChangeMeStrongPassword123!

# Storage Configuration
# STORAGE_DIR=../storage
